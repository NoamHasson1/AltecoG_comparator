# Copy this file to .env and fill in real values for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead
# (or let the relevant integration inject them automatically, see DATABASE_URL below).

# Anthropic API key, for the AI-assisted mapping suggestion feature.
# Without this set, that feature returns a clear "not configured" error but
# the rest of the app still works.
ANTHROPIC_API_KEY=

# Postgres connection string for saved-mapping storage. When you connect a
# Postgres integration (e.g. Neon) to your Vercel project, this is added to
# your Vercel env vars automatically — copy the same value here for local dev.
# Without this set, saved mappings return a clear "not configured" error but
# uploading/reconciling files still works.
DATABASE_URL=
