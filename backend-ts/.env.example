# Copy this file to .env and fill in real values for local development.

# Anthropic API key, for the AI-assisted mapping suggestion feature.
# Without this set, that feature returns a clear "not configured" error but
# the rest of the app still works.
ANTHROPIC_API_KEY=

# MongoDB connection string for saved-mapping storage.
# For local dev, the simplest option is a throwaway Docker container:
#   docker run -d --name altego-mongo -p 27017:27017 mongo:7
# then use: MONGODB_URI=mongodb://127.0.0.1:27017/altego_dev
# Without this set, saved mappings return a clear "not configured" error but
# uploading/reconciling files still works.
MONGODB_URI=

# Port the server listens on locally (defaults to 5001 if unset).
PORT=5001

# error | warn | info | debug (default). debug matches the old Python
# backend's verbosity -- full DataFrame-equivalent dumps and every field
# comparison, not just mismatches. Drop to info for less noise on large files.
LOG_LEVEL=debug
