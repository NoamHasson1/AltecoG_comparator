{
  "name": "altego-backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "TypeScript/Express port of the Python FastAPI backend (see ../backend). Same REST API contract, MongoDB instead of Postgres.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=4096 dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "mongodb": "^6.11.0",
    "multer": "^2.2.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.2.2",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.23.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
